-- ГЛАВНЫЕ ЦИКЛЫ
local tCase,tFuse,tSunSpin,tSunColl,tNGSpin,tCal,tUpg=0,0,0,0,0,0,0
RUN.Heartbeat:Connect(function(dt)
	tCase=tCase+dt
	if CFG.autoCase and tCase>=0.05 then tCase=0
		for n,_ in pairs(CFG.sel)do
			pcall(function()Events.OpenCase:InvokeServer(n,10)end)
			if CFG.autoSell then task.spawn(function()task.wait(0.5)pcall(function()for _,i in pairs(getInv():GetChildren())do if not isFav(i)then Events.Inventory:FireServer("Sell",i.Name,false)task.wait(0.03)end end end)end)end
		end
	end
	tFuse=tFuse+dt
	if CFG.fuseOn and tFuse>=0.2 then tFuse=0
		pcall(function()local g={};for _,i in pairs(getInv():GetChildren())do if not(CFG.fuseFavSkip and isFav(i))and not i:GetAttribute("Unique")then g[i.Name]=g[i.Name]or{};table.insert(g[i.Name],i)end end;for _,items in pairs(g)do if#items>=5 then Events.Fuse:InvokeServer("Fuse",{items[1],items[2],items[3],items[4],items[5]},true)break end end end)
	end
	tSunSpin=tSunSpin+dt
	if CFG.sunSpinOn and tSunSpin>=1 then tSunSpin=0;pcall(function()Events.Summer:InvokeServer("Spin")end)end
	tSunColl=tSunColl+dt
	if CFG.sunCollOn and tSunColl>=30 then tSunColl=0;pcall(function()Events.Summer:InvokeServer("CollectSun")end)end
	tNGSpin=tNGSpin+dt
	if CFG.ngSpinOn and tNGSpin>=0.8 then tNGSpin=0;pcall(function()Events.Spin:InvokeServer("Spin")end)end
	tCal=tCal+dt
	if CFG.autoCalOn and tCal>=0.4 then tCal=0;pcall(function()Events.OpenCase:InvokeServer("Desk Calendars",1)end)end
	tUpg=tUpg+dt
	if CFG.autoUpgOn and tUpg>=0.15 then tUpg=0
		pcall(function()local inv=getInv();local i1=inv:FindFirstChild(CFG.upg1);local i2=inv:FindFirstChild(CFG.upg2);if i1 and i2 then Events.Upgrade:InvokeServer(i1,i2)end end)
	end
end)
-- АНТИ-АФК
local afkT=0
RUN.Heartbeat:Connect(function(dt)afkT=afkT+dt;if afkT>=55 then afkT=0;pcall(function()local c=workspace:FindFirstChildWhichIsA("Camera")if c then c.CFrame=c.CFrame*CFrame.Angles(0,0.001,0)end end)end end)

