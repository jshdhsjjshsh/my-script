tog(p4,"Пропускать фавориты","fuseFavSkip")
btn(p4,"🔥 Фьюз x1",function()
	pcall(function()
		local g={};for _,i in pairs(getInv():GetChildren())do if not(CFG.fuseFavSkip and isFav(i))and not i:GetAttribute("Unique")then g[i.Name]=g[i.Name]or{};table.insert(g[i.Name],i)end end
		for _,items in pairs(g)do if#items>=5 then Events.Fuse:InvokeServer("Fuse",{items[1],items[2],items[3],items[4],items[5]},true)break end end
	end)
end,Color3.fromRGB(140,0,200))
btn(p4,"🔥 Фьюз ALL",function()
	task.spawn(function()
		local done=false;repeat done=true
			local g={};pcall(function()for _,i in pairs(getInv():GetChildren())do if not(CFG.fuseFavSkip and isFav(i))and not i:GetAttribute("Unique")then g[i.Name]=g[i.Name]or{};table.insert(g[i.Name],i)end end end)
			for _,items in pairs(g)do if#items>=5 then pcall(function()Events.Fuse:InvokeServer("Fuse",{items[1],items[2],items[3],items[4],items[5]},true)end)done=false;task.wait(0.3);break end end
		until done;notify("Фьюз","Все фьюзы выполнены!")
	end)
end,Color3.fromRGB(100,0,180))
