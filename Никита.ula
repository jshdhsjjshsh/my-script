inp(p8,"⭐ Звёзды",function(t)local v=LP:FindFirstChild("_StarsValue")if v then v.Value=tonumber(t)or v.Value end;updBal()end)
inp(p8,"💠 TON",function(t)local v=LP:FindFirstChild("_TONValue")if v then v.Value=tonumber(t)or v.Value end;updBal()end)
inp(p8,"💎 Гемы",function(t)local v=LP:FindFirstChild("_GemsValue")if v then v.Value=tonumber(t)or v.Value end end)
