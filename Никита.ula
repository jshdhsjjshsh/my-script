inp(p8,"☀ Солнца",function(t)local v=LP:FindFirstChild("_SunValue")if v then v.Value=tonumber(t)or v.Value end;updSun()end)
inp(p8,"🌀 Летних спинов",function(t)local v=LP:FindFirstChild("_SummerSpinsValue")if v then v.Value=tonumber(t)or v.Value end;updSun()end)
sec(p8,"Бонусы")
local luckSecs={}
local function mkLuckRow(par,label,key1,key2,defSec)
	local f=N("lr","Frame",{Size=UDim2.new(1,0,0,50),BackgroundColor3=PANEL,BorderSizePixel=0},par)
	corner(f,6)stroke(f,Theme,1)
	N("l","TextLabel",{Size=UDim2.new(0.5,0,0,18),Position=UDim2.new(0,4,0,2),BackgroundTransparency=1,Text=label,TextColor3=WHITE,TextScaled=true,Font=Enum.Font.GothamBold,TextXAlignment=Enum.TextXAlignment.Left},f)
	local secBox=N("sb","TextBox",{Size=UDim2.new(0.45,0,0,20),Position=UDim2.new(0,4,0,22),BackgroundColor3=BG,Text=tostring(defSec),PlaceholderText="сек",TextColor3=Color3.fromRGB(180,100,255),TextScaled=true,Font=Enum.Font.Gotham,BorderSizePixel=0},f)
	corner(secBox,4)stroke(secBox,Theme,1)
	local timerL=N("tl","TextLabel",{Size=UDim2.new(0.4,0,0,20),Position=UDim2.new(0.5,0,0,22),BackgroundTransparency=1,Text="⏱ —",TextColor3=GOLD,TextScaled=true,Font=Enum.Font.GothamBold},f)
	local runBtn=N("rb","TextButton",{Size=UDim2.new(0.48,0,0,18),Position=UDim2.new(0.52,0,0,2),BackgroundColor3=GREEN,Text="▶",TextColor3=WHITE,TextScaled=true,Font=Enum.Font.GothamBold,BorderSizePixel=0},f)
	corner(runBtn,4)
	local running=false
	runBtn.MouseButton1Click:Connect(function()
		running=not running
		tw(runBtn,0.12,{BackgroundColor3=running and RED or GREEN})
		runBtn.Text=running and"■"or"▶"
		if running then task.spawn(function()
			local secs=tonumber(secBox.Text)or defSec
			if key1 then local v=RS:FindFirstChild(key1)if v then v.Value=600 end end
			if key2 then local v=LP:FindFirstChild(key2)if v then v.Value=600 end end
			while running and secs>0 do
				timerL.Text="⏱ "..secs.."с"
				task.wait(1);secs=secs-1
			end
			if secs<=0 then
				if key1 then local v=RS:FindFirstChild(key1)if v then v.Value=0 end end
				if key2 then local v=LP:FindFirstChild(key2)if v then v.Value=0 end end
				timerL.Text="⏱ 0"
				running=false
				tw(runBtn,0.12,{BackgroundColor3=GREEN});runBtn.Text="▶"
			end
		end)end
	end)
end
mkLuckRow(p8,"🍀 Удача x2","LuckValue","_LuckyPotion",120)
mkLuckRow(p8,"🍀 Удача x4","LuckValue2","_LuckyPotion2",120)
mkLuckRow(p8,"✝ Благословение","CrossValue",nil,60)
btn(p8,"⚡ Fast Upgrade",function()local p=LP:FindFirstChild("_1628441770")or Instance.new("NumberValue",LP);p.Name="_1628441770";p.Value=1;notify("Чит","Fast Upgrade!")end,Color3.fromRGB(0,160,80))
btn(p8,"📊 Индекс MAX",function()local idx=LP:FindFirstChild("_Index")if idx then for _,v in pairs(idx:GetChildren())do if v:IsA("IntValue")then v.Value=999999 end end end;notify("Чит","Индекс!")end,Theme)
btn(p8,"🔓 Все геймпасы",function()for _,id in ipairs({1628441770,1651738174,1640776898})do local p=LP:FindFirstChild("_"..id)or Instance.new("NumberValue",LP);p.Name="_"..id;p.Value=1 end;notify("Чит","Геймпасы!")end,Color3.fromRGB(0,100,50))
sec(p8,"NFT утилиты")
inp(p8,"NFT в инвентарь",function(t)pcall(function()local v=Instance.new("StringValue",getInv());v.Name=t end);notify("NFT","Добавлен: "..t)end)
inp(p8,"Лучший дроп (визуал)",function(t)local d=LP:FindFirstChild("_BestDrop")if d then d.Value=t end end)
inp(p8,"TON NFT (Название)",function(t)
	pcall(function()
		local inv=getInv()
		local v=Instance.new("StringValue",inv);v.Name=t
		v:SetAttribute("TON",true);v:SetAttribute("Favorite",true)
		v:SetAttribute("Date",os.date("%d.%m.%Y"))
		notify("NFT","TON NFT создан: "..t)
	end)
end)

