local sumPage=getPage("summer")
local sunLbl=N("sl","TextLabel",{Size=UDim2.new(1,-4,0,38),BackgroundColor3=NC.panel,Text="☀ Солнца: — | 🌀 Летних спинов: — | ⏱ Накоплено: —",TextColor3=NC.gold,TextScaled=true,Font=Enum.Font.GothamBold,BorderSizePixel=0})
sunLbl.Parent=sumPage;corner(sunLbl,8);stroke(sunLbl,NC.neon1,1)

local function updateSunLbl()
	local sv=LP:FindFirstChild("_SunValue")or LP:FindFirstChild("SunValue")
	local spv=LP:FindFirstChild("_SummerSpinsValue")or LP:FindFirstChild("SummerSpinsValue")
	local accv=LP:FindFirstChild("_SunAccumValue")or LP:FindFirstChild("SunAccumValue")
	sunLbl.Text=("☀ %s | 🌀 %s спинов | ⏱ %s накоплено"):format(
		fmt(sv and sv.Value or 0),
		fmt(spv and spv.Value or 0),
		fmt(accv and accv.Value or 0))
end
updateSunLbl()

mkBtn(sumPage,"☀ Собрать солнца",function()
	pcall(function()Events.Summer:InvokeServer("CollectSun")end)
