-- ПЕРЕТАСКИВАНИЕ
local drag,ds,sp=false,nil,nil
TBar.InputBegan:Connect(function(i)if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then drag=true;ds=i.Position;sp=Main.Position end end)
UIS.InputChanged:Connect(function(i)if drag and(i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch)then local d=i.Position-ds;Main.Position=UDim2.new(sp.X.Scale,sp.X.Offset+d.X,sp.Y.Scale,sp.Y.Offset+d.Y)end end)
UIS.InputEnded:Connect(function(i)if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then drag=false end end)

-- ГОРЯЧИЕ КЛАВИШИ
UIS.InputBegan:Connect(function(i,gp)
	if gp then return end
	if i.KeyCode==Enum.KeyCode.Insert then Main.Visible=not Main.Visible end
end)

-- ГЛАВНЫЕ ЦИКЛЫ
local caseT=0
local fuseT=0
local sunSpinT=0
local sunCollT=0
local ngSpinT=0
local calT=0
local upgT=0

RUN.Heartbeat:Connect(function(dt)
	-- Авто кейсы
	caseT=caseT+dt
	if CFG.autoCaseOn and caseT>=0.1 then
		caseT=0
		for n,_ in pairs(CFG.selCases)do
			pcall(function()Events.OpenCase:InvokeServer(n,10)end)
			if CFG.autoSell then
				task.spawn(function()
					task.wait(0.5)
					pcall(function()
						for _,item in pairs((LP:FindFirstChild("_Inventory")or LP:FindFirstChild("Inventory")):GetChildren())do
							if not isFav(item)then Events.Inventory:FireServer("Sell",item.Name,false)task.wait(0.04)end
						end
					end)
				end)
			end
		end
	end
	-- Авто фьюз
	fuseT=fuseT+dt
	if CFG.fuseOn and fuseT>=0.3 then
		fuseT=0
		pcall(function()
			local groups={}
			local inv=LP:FindFirstChild("_Inventory")or LP:FindFirstChild("Inventory")
			if not inv then return end
			for _,item in pairs(inv:GetChildren())do
				if not(CFG.fuseFavSkip and isFav(item))and not item:GetAttribute("Unique")then
					groups[item.Name]=groups[item.Name]or{}
					table.insert(groups[item.Name],item)
				end
			end
			for _,items in pairs(groups)do
				if#items>=5 then
					Events.Fuse:InvokeServer("Fuse",{items[1],items[2],items[3],items[4],items[5]},true)
					break
				end
			end
		end)
	end
	-- Авто летний спин
	sunSpinT=sunSpinT+dt
	if CFG.sunSpinOn and sunSpinT>=1 then
		sunSpinT=0
		pcall(function()Events.Summer:InvokeServer("Spin")end)
	end
	-- Авто сбор солнц
	sunCollT=sunCollT+dt
	if CFG.sunCollectOn and sunCollT>=30 then
		sunCollT=0
		pcall(function()Events.Summer:InvokeServer("CollectSun")end)
	end
	-- Авто НГ спин
	ngSpinT=ngSpinT+dt
	if CFG.ngSpinOn and ngSpinT>=0.8 then
		ngSpinT=0
		pcall(function()Events.Spin:InvokeServer("Spin")end)
	end
	-- Авто крафт календарей
	calT=calT+dt
	if CFG.autoCalOn and calT>=0.5 then
		calT=0
		pcall(function()Events.OpenCase:InvokeServer("Desk Calendars",1)end)
	end
	-- Авто апгрейд
	upgT=upgT+dt
	if CFG.autoUpgOn and upgT>=0.15 then
		upgT=0
		pcall(function()
			local inv=LP:FindFirstChild("_Inventory")or LP:FindFirstChild("Inventory")
			local item1=inv and inv:FindFirstChild(CFG.upg1)
			local item2=inv and inv:FindFirstChild(CFG.upg2)
			if item1 and item2 then Events.Upgrade:InvokeServer(item1,item2)end
		end)
	end
end)

-- АНТИ-АФК
local afkT=0
RUN.Heartbeat:Connect(function(dt)
	afkT=afkT+dt
	if afkT>=55 then
		afkT=0
		pcall(function()local c=workspace:FindFirstChildWhichIsA("Camera")if c then c.CFrame=c.CFrame*CFrame.Angles(0,0.001,0)end end)
	end
end)

