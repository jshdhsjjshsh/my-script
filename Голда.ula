local XBtn=N("X","TextButton",{Size=UDim2.new(0,28,0,28),Position=UDim2.new(1,-32,0,9),BackgroundColor3=NC.red,Text="✕",TextColor3=NC.text,TextScaled=true,Font=Enum.Font.GothamBold,BorderSizePixel=0})
XBtn.Parent=TBar;corner(XBtn,6)
XBtn.MouseButton1Click:Connect(function()
	Main.Visible=false
	local ico=N("ico","TextButton",{Size=UDim2.new(0,46,0,46),Position=UDim2.new(0,8,0.5,-23),BackgroundColor3=NC.neon2,Text="⚡",TextScaled=true,Font=Enum.Font.GothamBold,TextColor3=NC.text,ZIndex=999,BorderSizePixel=0})
	ico.Parent=SG;corner(ico,23);stroke(ico,NC.neon1,2)
	ico.MouseButton1Click:Connect(function()Main.Visible=true;ico:Destroy()end)
end)

-- SIDEBAR + PAGES
local Sidebar=N("sb","Frame",{Size=UDim2.new(0,46,1,-46),Position=UDim2.new(0,0,0,46),BackgroundColor3=NC.panel,BorderSizePixel=0})
Sidebar.Parent=Main;corner(Sidebar,0)
stroke(Sidebar,NC.neon2,1)
N("l","UIListLayout",{FillDirection=Enum.FillDirection.Vertical,HorizontalAlignment=Enum.HorizontalAlignment.Center,VerticalAlignment=Enum.VerticalAlignment.Top,Padding=UDim.new(0,2)}):Parent=Sidebar
N("p","UIPadding",{PaddingTop=UDim.new(0,4)}):Parent=Sidebar

local PagesFrame=N("pf","Frame",{Size=UDim2.new(1,-50,1,-50),Position=UDim2.new(0,48,0,48),BackgroundTransparency=1})
PagesFrame.Parent=Main

local TABS={
{ic="📦",nm="cases"},{ic="⚔",nm="battles"},{ic="🔥",nm="fuse"},{ic="⬆",nm="upgrade"},
{ic="☀",nm="summer"},{ic="❄",nm="ng"},{ic="🎄",nm="craft"},{ic="🔧",nm="cheat"},{ic="⚙",nm="settings"}
}
local tabBtns={}
local pageFrames={}
local curTab=nil

local function switchTab(nm)
	for _,b in pairs(tabBtns)do tw(b,0.15,{BackgroundColor3=b.Name==nm and NC.neon1 or NC.panel})end
	for _,p in pairs(pageFrames)do p.Visible=p.Name==nm end
	curTab=nm
end

for _,tab in ipairs(TABS)do
	local btn=N(tab.nm,"TextButton",{Size=UDim2.new(0,38,0,38),BackgroundColor3=NC.panel,Text=tab.ic,TextScaled=true,Font=Enum.Font.GothamBold,TextColor3=NC.text,BorderSizePixel=0})
	btn.Parent=Sidebar;corner(btn,8)
	table.insert(tabBtns,btn)
	btn.MouseButton1Click:Connect(function()switchTab(tab.nm)end)

	local pg=N(tab.nm,"ScrollingFrame",{Size=UDim2.new(1,0,1,0),BackgroundTransparency=1,BorderSizePixel=0,Visible=false,ScrollBarThickness=3,ScrollBarImageColor3=NC.neon1,CanvasSize=UDim2.new(0,0,0,0),AutomaticCanvasSize=Enum.AutomaticSize.Y})
	pg.Parent=PagesFrame;table.insert(pageFrames,pg)
	N("l","UIListLayout",{Padding=UDim.new(0,5),SortOrder=Enum.SortOrder.LayoutOrder}):Parent=pg
	N("p","UIPadding",{PaddingTop=UDim.new(0,4),PaddingLeft=UDim.new(0,2),PaddingRight=UDim.new(0,4)}):Parent=pg
end

local function getPage(nm)for _,p in pairs(pageFrames)do if p.Name==nm then return p end end end

-- HELPERS
local function mkSection(parent,txt)
	local f=N("sec_"..txt,"TextLabel",{Size=UDim2.new(1,-4,0,18),BackgroundTransparency=1,Text="── "..txt.." ──",TextColor3=NC.neon1,TextScaled=true,Font=Enum.Font.GothamBold})
	f.Parent=parent;return f
end
local function mkToggle(parent,lbl,cfgKey)
	local row=N("r_"..lbl,"Frame",{Size=UDim2.new(1,-4,0,32),BackgroundColor3=NC.panel,BorderSizePixel=0})
	row.Parent=parent;corner(row,7);stroke(row,NC.border,1)
	local lb=N("l","TextLabel",{Size=UDim2.new(0.65,0,1,0),Position=UDim2.new(0,8,0,0),BackgroundTransparency=1,Text=lbl,TextColor3=NC.text,TextScaled=true,Font=Enum.Font.Gotham,TextXAlignment=Enum.TextXAlignment.Left})
	lb.Parent=row
	local tog=N("t","TextButton",{Size=UDim2.new(0,64,0,22),Position=UDim2.new(1,-70,0.5,-11),BackgroundColor3=NC.red,Text=L.off,TextColor3=NC.text,TextScaled=true,Font=Enum.Font.GothamBold,BorderSizePixel=0})
	tog.Parent=row;corner(tog,5)
	local function upd()tw(tog,0.12,{BackgroundColor3=CFG[cfgKey]and NC.green or NC.red})tog.Text=CFG[cfgKey]and L.on or L.off end
	upd()
	tog.MouseButton1Click:Connect(function()CFG[cfgKey]=not CFG[cfgKey];upd()end)
	return tog
end
local function mkBtn(parent,lbl,cb,clr)
	local btn=N("btn_"..lbl,"TextButton",{Size=UDim2.new(1,-4,0,32),BackgroundColor3=clr or NC.accent,Text=lbl,TextColor3=NC.text,TextScaled=true,Font=Enum.Font.GothamBold,BorderSizePixel=0})
	btn.Parent=parent;corner(btn,7);stroke(btn,NC.neon1,1)
	btn.MouseButton1Click:Connect(cb)
	btn.MouseEnter:Connect(function()tw(btn,0.1,{BackgroundColor3=NC.neon2})end)
	btn.MouseLeave:Connect(function()tw(btn,0.1,{BackgroundColor3=clr or NC.accent})end)
	return btn
end
local function mkInput(parent,ph,cb)
	local row=N("inp_"..ph,"Frame",{Size=UDim2.new(1,-4,0,32),BackgroundColor3=NC.panel,BorderSizePixel=0})
	row.Parent=parent;corner(row,7);stroke(row,NC.border,1)
	local box=N("box","TextBox",{Size=UDim2.new(0.7,0,1,-4),Position=UDim2.new(0,4,0,2),BackgroundColor3=NC.bg,PlaceholderText=ph,Text="",TextColor3=NC.neon1,PlaceholderColor3=NC.dim,TextScaled=true,Font=Enum.Font.Gotham,BorderSizePixel=0})
	box.Parent=row;corner(box,5)
	local ok=N("ok","TextButton",{Size=UDim2.new(0.28,0,1,-4),Position=UDim2.new(0.72,0,0,2),BackgroundColor3=NC.neon2,Text="OK",TextColor3=NC.text,TextScaled=true,Font=Enum.Font.GothamBold,BorderSizePixel=0})
	ok.Parent=row;corner(ok,5)
	ok.MouseButton1Click:Connect(function()if box.Text~=""then cb(box.Text)box.Text=""end end)
	box.FocusLost:Connect(function(enter)if enter and box.Text~=""then cb(box.Text)box.Text=""end end)
	return box
end

-- КЕЙС КАРТОЧКА
local function mkCaseCard(parent,caseData,onOpen)
	local card=N("c_"..caseData.n,"Frame",{Size=UDim2.new(1,-4,0,72),BackgroundColor3=NC.panel,BorderSizePixel=0})
	card.Parent=parent;corner(card,10);stroke(card,NC.border,1)
	grad(card,Color3.fromRGB(20,0,40),Color3.fromRGB(10,0,25),135)

	local img=N("img","ImageLabel",{Size=UDim2.new(0,60,0,60),Position=UDim2.new(0,6,0.5,-30),BackgroundTransparency=1,Image="rbxassetid://"..tostring(caseData.img)})
	img.Parent=card
	-- нажатие на фото = открыть меню кейса
	local imgBtn=N("ib","TextButton",{Size=UDim2.new(1,0,1,0),BackgroundTransparency=1,Text="",ZIndex=2})
	imgBtn.Parent=img
	imgBtn.MouseButton1Click:Connect(function()
		pcall(function()Events.GUI:Fire("CasePage",caseData.n)end)
	end)

	local nm=N("nm","TextLabel",{Size=UDim2.new(0.4,0,0.45,0),Position=UDim2.new(0,74,0,6),BackgroundTransparency=1,Text=caseData.n,TextColor3=NC.text,TextScaled=true,Font=Enum.Font.GothamBold,TextXAlignment=Enum.TextXAlignment.Left})
	nm.Parent=card
	local priceClr= caseData.p==0 and NC.green or NC.gold
	local prIcon= caseData.sunCost and "☀" or caseData.snowCost and "❄" or "⭐"
	local pr=N("pr","TextLabel",{Size=UDim2.new(0.4,0,0.4,0),Position=UDim2.new(0,74,0.5,0),BackgroundTransparency=1,Text=prIcon..fmt(caseData.p),TextColor3=priceClr,TextScaled=true,Font=Enum.Font.Gotham,TextXAlignment=Enum.TextXAlignment.Left})
	pr.Parent=card

	local o1=N("o1","TextButton",{Size=UDim2.new(0,52,0,26),Position=UDim2.new(1,-116,0.15,0),BackgroundColor3=NC.neon2,Text="x1",TextColor3=NC.text,TextScaled=true,Font=Enum.Font.GothamBold,BorderSizePixel=0})
	o1.Parent=card;corner(o1,6)
	local o10=N("o10","TextButton",{Size=UDim2.new(0,52,0,26),Position=UDim2.new(1,-60,0.15,0),BackgroundColor3=NC.neon1,Text="x10",TextColor3=NC.bg,TextScaled=true,Font=Enum.Font.GothamBold,BorderSizePixel=0})
	o10.Parent=card;corner(o10,6)

	local selBtn=N("sel","TextButton",{Size=UDim2.new(1,-80,0,22),Position=UDim2.new(0,74,0.6,0),BackgroundColor3=CFG.selCases[caseData.n] and NC.green or NC.panel,Text=CFG.selCases[caseData.n] and "✓ Выбран" or "+ Авто",TextColor3=NC.text,TextScaled=true,Font=Enum.Font.Gotham,BorderSizePixel=0})
	selBtn.Parent=card;corner(selBtn,5);stroke(selBtn,NC.border,1)
	selBtn.MouseButton1Click:Connect(function()
		CFG.selCases[caseData.n]=not CFG.selCases[caseData.n]
		tw(selBtn,0.12,{BackgroundColor3=CFG.selCases[caseData.n]and NC.green or NC.panel})
		selBtn.Text=CFG.selCases[caseData.n]and"✓ Выбран"or"+ Авто"
	end)
	o1.MouseButton1Click:Connect(function()
		pcall(function()Events.OpenCase:InvokeServer(caseData.n,1)end)
		if onOpen then onOpen(caseData.n,1)end
	end)
	o10.MouseButton1Click:Connect(function()
		pcall(function()Events.OpenCase:InvokeServer(caseData.n,10)end)
		if onOpen then onOpen(caseData.n,10)end
	end)
	return card
end

-- БАТЛ КАРТОЧКА (кейс + поле количества)
local battleCaseCounts={}
local function mkBattleCard(parent,caseData)
	battleCaseCounts[caseData.n]=battleCaseCounts[caseData.n]or 0
	local card=N("bc_"..caseData.n,"Frame",{Size=UDim2.new(1,-4,0,58),BackgroundColor3=NC.panel,BorderSizePixel=0})
	card.Parent=parent;corner(card,8);stroke(card,NC.border,1)

	local img=N("img","ImageLabel",{Size=UDim2.new(0,46,0,46),Position=UDim2.new(0,4,0.5,-23),BackgroundTransparency=1,Image="rbxassetid://"..tostring(caseData.img)})
	img.Parent=card
	local nm=N("nm","TextLabel",{Size=UDim2.new(0.38,0,0.5,0),Position=UDim2.new(0,56,0,4),BackgroundTransparency=1,Text=caseData.n,TextColor3=NC.text,TextScaled=true,Font=Enum.Font.Gotham,TextXAlignment=Enum.TextXAlignment.Left})
	nm.Parent=card
	local pr=N("pr","TextLabel",{Size=UDim2.new(0.38,0,0.4,0),Position=UDim2.new(0,56,0.5,0),BackgroundTransparency=1,Text="⭐"..fmt(caseData.p),TextColor3=NC.gold,TextScaled=true,Font=Enum.Font.Gotham,TextXAlignment=Enum.TextXAlignment.Left})
	pr.Parent=card

	local cntBox=N("cnt","TextBox",{Size=UDim2.new(0,54,0,26),Position=UDim2.new(1,-62,0.5,-13),BackgroundColor3=NC.bg,Text="0",PlaceholderText="шт",TextColor3=NC.neon1,TextScaled=true,Font=Enum.Font.GothamBold,BorderSizePixel=0})
	cntBox.Parent=card;corner(cntBox,5);stroke(cntBox,NC.neon2,1)
	cntBox.FocusLost:Connect(function()
		local v=tonumber(cntBox.Text)or 0
		battleCaseCounts[caseData.n]=math.min(v,20)
		cntBox.Text=tostring(battleCaseCounts[caseData.n])
	end)
end

-- ═══════════ СТРАНИЦА КЕЙСОВ ═══════════
local cPage=getPage("cases")
mkSection(cPage,"Авто-открытие кейсов")
mkToggle(cPage,"Авто открытие","autoCaseOn")
mkToggle(cPage,"Авто продажа (без фаворитов)","autoSell")
mkBtn(cPage,"💸 Продать всё без фаворитов",function()
	local sold=0
	pcall(function()
		for _,item in pairs((LP:FindFirstChild("_Inventory")or LP:FindFirstChild("Inventory")):GetChildren())do
			if not isFav(item)then Events.Inventory:FireServer("Sell",item.Name,false)sold=sold+1;task.wait(0.04)end
		end
	end)
	notify("Продажа","Продано: "..sold)
end,NC.neon3)
mkSection(cPage,"Все кейсы")
for _,cd in ipairs(Cases)do mkCaseCard(cPage,cd)end

-- ═══════════ СТРАНИЦА БАТЛОВ ═══════════
local bPage=getPage("battles")
mkSection(bPage,"Кейсы для батла (впиши количество)")
for _,cd in ipairs(Cases)do mkBattleCard(bPage,cd)end
mkSection(bPage,"Настройки")
mkToggle(bPage,"Всегда с ботом","battleBot")

-- КНОПКА СТАРТ БАТЛА (одна, только создать)
local battleStartBtn=mkBtn(bPage,"▶ СОЗДАТЬ и СТАРТ",function()end,NC.green)
local battleRunning=false
battleStartBtn.MouseButton1Click:Connect(function()
	battleRunning=not battleRunning
	battleStartBtn.Text=battleRunning and"■ СТОП"or"▶ СОЗДАТЬ и СТАРТ"
	tw(battleStartBtn,0.15,{BackgroundColor3=battleRunning and NC.red or NC.green})
	if battleRunning then
		task.spawn(function()
			while battleRunning do
				local bc={}
				for n,cnt in pairs(battleCaseCounts)do
					for i=1,cnt do table.insert(bc,n)end
				end
				if#bc>0 then
					if CFG.battleBot then pcall(function()Events.Battles:InvokeServer("CallABot")end)task.wait(0.5)end
					pcall(function()Events.Battles:InvokeServer("Create",bc,{})end)
				end
				task.wait(3)
			end
		end)
	end
end)

-- ЦЕПОЧКА БАТЛОВ
mkSection(bPage,"Цепочка батлов")
local chainItems={}
local chainDisplay=N("cd","TextLabel",{Size=UDim2.new(1,-4,0,40),BackgroundColor3=NC.bg,Text="Цепочка пуста",TextColor3=NC.dim,TextScaled=true,Font=Enum.Font.Gotham,BorderSizePixel=0})
chainDisplay.Parent=bPage;corner(chainDisplay,6)

local function updateChainDisplay()
	if#chainItems==0 then chainDisplay.Text="Цепочка пуста";return end
	local t=""
	for i,item in ipairs(chainItems)do t=t..i..". "..item.mode.." ставка "..fmt(item.bet).."\n"end
	chainDisplay.Text=t
end

local chainModeBox=N("cmb","TextBox",{Size=UDim2.new(0.48,0,0,28),BackgroundColor3=NC.bg,Text="default",TextColor3=NC.neon1,TextScaled=true,Font=Enum.Font.Gotham,BorderSizePixel=0})
chainModeBox.Parent=bPage;corner(chainModeBox,5);stroke(chainModeBox,NC.border,1)
local chainBetBox=N("cbb","TextBox",{Size=UDim2.new(0.48,0,0,28),Position=UDim2.new(0.52,0,0,0),BackgroundColor3=NC.bg,Text="1000",TextColor3=NC.neon1,TextScaled=true,Font=Enum.Font.Gotham,BorderSizePixel=0})
chainBetBox.Parent=bPage;corner(chainBetBox,5);stroke(chainBetBox,NC.border,1)

mkBtn(bPage,"+ Добавить в цепочку",function()
	local mode=chainModeBox.Text~=""and chainModeBox.Text or"default"
	local bet=tonumber(chainBetBox.Text)or 1000
	table.insert(chainItems,{mode=mode,bet=bet})
	updateChainDisplay()
end,NC.accent)
mkBtn(bPage,"🗑 Очистить цепочку",function()chainItems={};updateChainDisplay()end,NC.red)

local chainRunBtn=mkBtn(bPage,"▶ Запустить цепочку",function()end,NC.neon2)
local chainRunning=false
chainRunBtn.MouseButton1Click:Connect(function()
	chainRunning=not chainRunning
	chainRunBtn.Text=chainRunning and"■ СТОП цепочки"or"▶ Запустить цепочку"
	tw(chainRunBtn,0.15,{BackgroundColor3=chainRunning and NC.red or NC.neon2})
	if chainRunning then
		task.spawn(function()
			while chainRunning do
				for _,item in ipairs(chainItems)do
					if not chainRunning then break end
					pcall(function()
						if CFG.battleBot then Events.Battles:InvokeServer("CallABot")task.wait(0.5)end
						Events.Battles:InvokeServer("Create",{},{Mode=item.mode,Bet=item.bet})
					end)
					task.wait(3)
				end
			end
		end)
	end
end)

