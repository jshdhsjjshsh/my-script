-- ═══════════ КРАФТ ═══════════
local craftPage=getPage("craft")
mkSection(craftPage,"Создать NFT в TON (локально)")
local tonPatBox=mkInput(craftPage,"Узор (1-20)",function(v)end)
local tonNumBox=mkInput(craftPage,"Номер",function(v)end)
local tonBgBox=mkInput(craftPage,"Фон (hex или название)",function(v)end)
local tonDateBox=mkInput(craftPage,"Дата (dd.mm.yyyy или авто)",function(v)end)
local tonNameBox=mkInput(craftPage,"Название NFT",function(v)end)

mkBtn(craftPage,"💎 Создать TON NFT локально",function()
	pcall(function()
		local inv=LP:FindFirstChild("_Inventory")or LP:FindFirstChild("Inventory")
		local nName=tonNameBox.Text~=""and tonNameBox.Text or"Custom TON"
		local date=tonDateBox.Text~=""and tonDateBox.Text or os.date("%d.%m.%Y")
		local nft=Instance.new("StringValue")
		nft.Name=nName
		nft:SetAttribute("TON",true)
		nft:SetAttribute("Pattern",tonPatBox.Text)
		nft:SetAttribute("Number",tonNumBox.Text)
		nft:SetAttribute("Background",tonBgBox.Text)
		nft:SetAttribute("Date",date)
		nft:SetAttribute("Favorite",true)
		nft.Parent=inv
		notify("Крафт","TON NFT создан: "..nName.." (в фаворите)")
	end)
end,NC.gold)

mkSection(craftPage,"Создать обычный NFT (локально)")
local spawnNameBox=mkInput(craftPage,"Название NFT",function(v)end)
local spawnCntBox=mkInput(craftPage,"Количество",function(v)end)
mkBtn(craftPage,"+ Заспавнить NFT локально",function()
	pcall(function()
		local inv=LP:FindFirstChild("_Inventory")or LP:FindFirstChild("Inventory")
		local nName=spawnNameBox.Text
		local cnt=tonumber(spawnCntBox.Text)or 1
		if nName==""then notify("Крафт","Введи название!")return end
		for i=1,cnt do
			local nft=Instance.new("StringValue")
			nft.Name=nName
			nft:SetAttribute("Favorite",true)
			nft.Parent=inv
		end
		notify("Крафт",("Создано %d x %s (в фаворите)"):format(cnt,nName))
	end)
end,NC.neon2)

mkSection(craftPage,"Кастомный кейс (локально)")
local customDrop={}
local customDropDisplay=N("cdd","TextLabel",{Size=UDim2.new(1,-4,0,50),BackgroundColor3=NC.bg,Text="Дропы не выбраны",TextColor3=NC.dim,TextScaled=true,Font=Enum.Font.Gotham,BorderSizePixel=0})
customDropDisplay.Parent=craftPage;corner(customDropDisplay,6)

local function updateCustomDrop()
	if#customDrop==0 then customDropDisplay.Text="Дропы не выбраны";return end
	local t=""
	for _,n in ipairs(customDrop)do t=t..n.."\n"end
	customDropDisplay.Text=t
end

mkSection(craftPage,"Выбор NFT для дропа")
local nftScroll=N("ns","ScrollingFrame",{Size=UDim2.new(1,-4,0,200),BackgroundColor3=NC.bg,BorderSizePixel=0,ScrollBarThickness=3,ScrollBarImageColor3=NC.neon1,CanvasSize=UDim2.new(0,0,0,0),AutomaticCanvasSize=Enum.AutomaticSize.Y})
nftScroll.Parent=craftPage;corner(nftScroll,8);stroke(nftScroll,NC.border,1)
N("l","UIListLayout",{Padding=UDim.new(0,3),SortOrder=Enum.SortOrder.LayoutOrder}):Parent=nftScroll
N("p","UIPadding",{PaddingTop=UDim.new(0,3),PaddingLeft=UDim.new(0,3),PaddingRight=UDim.new(0,3)}):Parent=nftScroll

local nftSelected={}
for _,nftName in ipairs(AllNFTs)do
	local btn=N("nft_"..nftName,"TextButton",{Size=UDim2.new(1,-4,0,24),BackgroundColor3=NC.panel,Text=nftName,TextColor3=NC.text,TextScaled=true,Font=Enum.Font.Gotham,BorderSizePixel=0})
	btn.Parent=nftScroll;corner(btn,5)
	stroke(btn,NC.border,0.5)
	btn.MouseButton1Click:Connect(function()
		nftSelected[nftName]=not nftSelected[nftName]
		tw(btn,0.1,{BackgroundColor3=nftSelected[nftName]and NC.green or NC.panel})
		customDrop={}
		for n,sel in pairs(nftSelected)do if sel then table.insert(customDrop,n)end end
		updateCustomDrop()
	end)
end

mkBtn(craftPage,"🎁 Создать кастомный кейс",function()
	if#customDrop==0 then notify("Крафт","Выбери хотя бы 1 NFT!")return end
	notify("Крафт",("Кейс создан с %d дропами!"):format(#customDrop))
end,NC.neon3)

