mkSection(cubePage,"Авто кубы с ботом")
local cubeModeFrame=N("cmf","Frame",{Size=UDim2.new(1,-4,0,34),BackgroundColor3=NC.panel,BorderSizePixel=0})
cubeModeFrame.Parent=cubePage;corner(cubeModeFrame,7);stroke(cubeModeFrame,NC.border,1)
local defBtn=N("def","TextButton",{Size=UDim2.new(0.48,0,1,-4),Position=UDim2.new(0,2,0,2),BackgroundColor3=NC.green,Text="Default",TextColor3=NC.bg,TextScaled=true,Font=Enum.Font.GothamBold,BorderSizePixel=0})
defBtn.Parent=cubeModeFrame;corner(defBtn,5)
local cursedBtn=N("cur","TextButton",{Size=UDim2.new(0.48,0,1,-4),Position=UDim2.new(0.52,0,0,2),BackgroundColor3=NC.panel,Text="Cursed",TextColor3=NC.text,TextScaled=true,Font=Enum.Font.GothamBold,BorderSizePixel=0})
cursedBtn.Parent=cubeModeFrame;corner(cursedBtn,5)
defBtn.MouseButton1Click:Connect(function()CFG.cubeMode="default";tw(defBtn,0.1,{BackgroundColor3=NC.green});tw(cursedBtn,0.1,{BackgroundColor3=NC.panel})end)
cursedBtn.MouseButton1Click:Connect(function()CFG.cubeMode="cursed";tw(cursedBtn,0.1,{BackgroundColor3=NC.neon3});tw(defBtn,0.1,{BackgroundColor3=NC.panel})end)

local cubeBetBox=N("cbet","TextBox",{Size=UDim2.new(1,-4,0,30),BackgroundColor3=NC.bg,Text="1000",PlaceholderText="Ставка",TextColor3=NC.neon1,TextScaled=true,Font=Enum.Font.GothamBold,BorderSizePixel=0})
cubeBetBox.Parent=cubePage;corner(cubeBetBox,6);stroke(cubeBetBox,NC.neon2,1)
cubeBetBox.FocusLost:Connect(function()CFG.cubeBet=tonumber(cubeBetBox.Text)or 1000;cubeBetBox.Text=tostring(CFG.cubeBet)end)

mkSection(cubePage,"Цепочка кубов")
local cubeChainItems={}
local cubeChainDisplay=N("ccd","TextLabel",{Size=UDim2.new(1,-4,0,50),BackgroundColor3=NC.bg,Text="Цепочка пуста",TextColor3=NC.dim,TextScaled=true,Font=Enum.Font.Gotham,BorderSizePixel=0})
cubeChainDisplay.Parent=cubePage;corner(cubeChainDisplay,6)

local function updateCubeChain()
	if#cubeChainItems==0 then cubeChainDisplay.Text="Цепочка пуста";return end
	local t=""
	for i,item in ipairs(cubeChainItems)do t=t..i..". "..item.mode.." | ставка "..fmt(item.bet).."\n"end
	cubeChainDisplay.Text=t
end

local cubeMode2Box=N("cm2","TextBox",{Size=UDim2.new(0.48,0,0,28),BackgroundColor3=NC.bg,Text="default",TextColor3=NC.neon1,TextScaled=true,Font=Enum.Font.Gotham,BorderSizePixel=0})
cubeMode2Box.Parent=cubePage;corner(cubeMode2Box,5);stroke(cubeMode2Box,NC.border,1)
local cubeBet2Box=N("cb2","TextBox",{Size=UDim2.new(0.48,0,0,28),BackgroundColor3=NC.bg,Text="1000",TextColor3=NC.neon1,TextScaled=true,Font=Enum.Font.Gotham,BorderSizePixel=0})
cubeBet2Box.Parent=cubePage;corner(cubeBet2Box,5);stroke(cubeBet2Box,NC.border,1)
mkBtn(cubePage,"+ Добавить в цепочку",function()
	local mode=cubeMode2Box.Text~=""and cubeMode2Box.Text or"default"
	local bet=tonumber(cubeBet2Box.Text)or 1000
	table.insert(cubeChainItems,{mode=mode,bet=bet})
	updateCubeChain()
end,NC.accent)
mkBtn(cubePage,"🗑 Очистить",function()cubeChainItems={};updateCubeChain()end,NC.red)

local cubeStartBtn=mkBtn(cubePage,"▶ СОЗДАТЬ КУБ (АВТО + БОТ)",function()end,NC.green)
local cubeRunning=false
cubeStartBtn.MouseButton1Click:Connect(function()
	cubeRunning=not cubeRunning
	cubeStartBtn.Text=cubeRunning and"■ СТОП"or"▶ СОЗДАТЬ КУБ (АВТО + БОТ)"
	tw(cubeStartBtn,0.15,{BackgroundColor3=cubeRunning and NC.red or NC.green})
	if cubeRunning then
		task.spawn(function()
			while cubeRunning do
				if#cubeChainItems>0 then
					for _,item in ipairs(cubeChainItems)do
						if not cubeRunning then break end
						pcall(function()Events.Dices:InvokeServer("Create",{Mode=item.mode,Bet=item.bet})end)
						task.wait(1)
						pcall(function()Events.Dices:InvokeServer("CallABot")end)
						task.wait(2)
					end
				else
					pcall(function()Events.Dices:InvokeServer("Create",{Mode=CFG.cubeMode,Bet=CFG.cubeBet})end)
					task.wait(1)
					pcall(function()Events.Dices:InvokeServer("CallABot")end)
					task.wait(2)
				end
			end
		end)
	end
end)

-- ═══════════ ФЬЮЗ ═══════════
local fusePage=getPage("fuse")
mkSection(fusePage,"Авто Фьюз")
mkToggle(fusePage,"Авто фьюз","fuseOn")
mkToggle(fusePage,"Не брать NFT из фаворитов","fuseFavSkip")
mkBtn(fusePage,"🔥 Фьюз x1",function()
	pcall(function()
		local groups={}
		for _,item in pairs((LP:FindFirstChild("_Inventory")or LP:FindFirstChild("Inventory")):GetChildren())do
			if not(CFG.fuseFavSkip and isFav(item))and not item:GetAttribute("Unique")then
				groups[item.Name]=groups[item.Name]or{}
				table.insert(groups[item.Name],item)
			end
		end
		for name,items in pairs(groups)do
			if#items>=5 then
				Events.Fuse:InvokeServer("Fuse",{items[1],items[2],items[3],items[4],items[5]},true)
				break
			end
		end
	end)
end,NC.neon2)
mkBtn(fusePage,"🔥 Фьюз ALL",function()
	task.spawn(function()
		local done=false
		repeat
			done=true
			local groups={}
			pcall(function()
				for _,item in pairs((LP:FindFirstChild("_Inventory")or LP:FindFirstChild("Inventory")):GetChildren())do
					if not(CFG.fuseFavSkip and isFav(item))and not item:GetAttribute("Unique")then
						groups[item.Name]=groups[item.Name]or{}
						table.insert(groups[item.Name],item)
					end
				end
			end)
			for _,items in pairs(groups)do
				if#items>=5 then
					pcall(function()Events.Fuse:InvokeServer("Fuse",{items[1],items[2],items[3],items[4],items[5]},true)end)
					done=false
					task.wait(0.3)
					break
				end
			end
		until done
		notify("Фьюз","Все возможные фьюзы выполнены!")
	end)
end,NC.neon3)
mkSection(fusePage,"Авто-крафт календарей")
mkToggle(fusePage,"Авто крафт Desk Calendars","autoCalOn")
mkBtn(fusePage,"📅 Крафт x1 Календарь",function()
	pcall(function()Events.OpenCase:InvokeServer("Desk Calendars",1)end)
end,NC.accent)

-- ═══════════ АПГРЕЙД ═══════════
local upgPage=getPage("upgrade")
mkSection(upgPage,"Авто Апгрейд")
mkToggle(upgPage,"Авто апгрейд","autoUpgOn")
local upg1Box=mkInput(upgPage,"NFT 1 (исходное)",function(v)CFG.upg1=v end)
local upg2Box=mkInput(upgPage,"NFT 2 (цель апгрейда)",function(v)CFG.upg2=v end)
mkBtn(upgPage,"⬆ Апгрейд x1",function()
	pcall(function()
		local inv=LP:FindFirstChild("_Inventory")or LP:FindFirstChild("Inventory")
		local item1=inv:FindFirstChild(CFG.upg1)
		local item2=inv:FindFirstChild(CFG.upg2)
		if item1 and item2 then
			Events.Upgrade:InvokeServer(item1,item2)
			notify("Апгрейд","Выполнен: "..CFG.upg1.." → "..CFG.upg2)
		else
			notify("Апгрейд","NFT не найдены в инвентаре")
		end
	end)
end,NC.neon2)
mkBtn(upgPage,"⬆ Апгрейд x10",function()
	for i=1,10 do
		pcall(function()
			local inv=LP:FindFirstChild("_Inventory")or LP:FindFirstChild("Inventory")
			local item1=inv:FindFirstChild(CFG.upg1)
			local item2=inv:FindFirstChild(CFG.upg2)
			if item1 and item2 then Events.Upgrade:InvokeServer(item1,item2)end
		end)
		task.wait(0.15)
	end
end,NC.accent)

