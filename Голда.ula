local function fmt(n)n=math.floor(tonumber(n)or 0)if n>=1e9 then return("%.1fB"):format(n/1e9)elseif n>=1e6 then return("%.1fM"):format(n/1e6)elseif n>=1e3 then return("%.1fK"):format(n/1e3)else return tostring(n)end end
local function getV(name)local v=LP:FindFirstChild(name)return v and v.Value or 0 end
local function isFav(item)return item:GetAttribute("Favorite")end

-- НАРИСОВАТЬ UI
local NC={
bg=Color3.fromRGB(8,0,18),
panel=Color3.fromRGB(16,0,32),
border=Color3.fromRGB(0,200,255),
accent=Color3.fromRGB(0,100,220),
neon1=Color3.fromRGB(0,220,255),
neon2=Color3.fromRGB(120,0,255),
neon3=Color3.fromRGB(255,0,200),
text=Color3.new(1,1,1),
dim=Color3.fromRGB(100,150,200),
green=Color3.fromRGB(0,220,80),
red=Color3.fromRGB(255,40,40),
gold=Color3.fromRGB(255,200,0),
}

local function N(nm,cl,pr)local o=Instance.new(cl)o.Name=nm;for k,v in pairs(pr or{})do o[k]=v end;return o end
local function corner(p,r)N("c","UICorner",{CornerRadius=UDim.new(0,r or 8)}):Parent=p end
local function stroke(p,c,t)N("s","UIStroke",{Color=c,Thickness=t or 1.5}):Parent=p end
local function grad(p,c1,c2,r)N("g","UIGradient",{Color=ColorSequence.new{ColorSequenceKeypoint.new(0,c1),ColorSequenceKeypoint.new(1,c2)},Rotation=r or 90}):Parent=p end
local function tw(o,t,g)TS:Create(o,TweenInfo.new(t),g):Play()end
local function notify(t,m)pcall(function()game:GetService("StarterGui"):SetCore("SendNotification",{Title=t,Text=m,Duration=3})end)end

local SG=N("NFT_v9","ScreenGui",{ResetOnSpawn=false,ZIndexBehavior=Enum.ZIndexBehavior.Sibling,DisplayOrder=999})
SG.Parent=PG

-- ГЛАВНОЕ ОКНО
local Main=N("Main","Frame",{Size=UDim2.new(0,520,0,600),Position=UDim2.new(0.5,-260,0.5,-300),BackgroundColor3=NC.bg,BorderSizePixel=0,ClipsDescendants=false})
Main.Parent=SG;corner(Main,12)
stroke(Main,NC.border,2)

-- TITLEBAR
local TBar=N("TB","Frame",{Size=UDim2.new(1,0,0,46),BackgroundColor3=NC.panel,BorderSizePixel=0})
TBar.Parent=Main;corner(TBar,12)
grad(TBar,NC.neon2,NC.neon1,90)

local TTitle=N("tt","TextLabel",{Size=UDim2.new(0.55,0,0,28),Position=UDim2.new(0,10,0,9),BackgroundTransparency=1,Text="⚡ NFT Battle v9",TextColor3=NC.text,TextScaled=true,Font=Enum.Font.GothamBold})
TTitle.Parent=TBar

-- БАЛАНС
local BalLbl=N("bal","TextLabel",{Size=UDim2.new(0.38,0,0,28),Position=UDim2.new(0.55,0,0,9),BackgroundTransparency=1,TextColor3=NC.gold,TextScaled=true,Font=Enum.Font.GothamBold,TextXAlignment=Enum.TextXAlignment.Right})
BalLbl.Parent=TBar

local function updBal()
	BalLbl.Text=("⭐%s 💠%s 💎%s"):format(fmt(getV("_StarsValue")),fmt(getV("_TONValue")),fmt(getV("_GemsValue")))
end
updBal()
for _,vn in ipairs({"_StarsValue","_TONValue","_GemsValue"})do
	local v=LP:FindFirstChild(vn)if v then v.Changed:Connect(updBal)end
end

